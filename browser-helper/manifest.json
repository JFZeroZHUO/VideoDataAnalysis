{
  "manifest_version": 3,
  "name": "母婴 AI 热榜浏览器助手",
  "version": "2.2.0",
  "description": "复用当前 Chrome 登录环境，批量读取母婴 AI 素材及视频号账号作品数据。",
  "permissions": ["tabs", "scripting", "alarms"],
  "host_permissions": [
    "http://127.0.0.1:4318/*",
    "https://www.douyin.com/*",
    "https://www.xiaohongshu.com/*",
    "https://channels.weixin.qq.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "母婴 AI 热榜浏览器助手",
    "default_popup": "popup.html"
  }
}
