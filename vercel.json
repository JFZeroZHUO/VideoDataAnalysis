{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npx --yes pnpm@11.19.0 run build:web",
  "installCommand": "npx --yes pnpm@11.19.0 install --frozen-lockfile",
  "outputDirectory": "dist-web",
  "functions": { "api/deepseek/[action].mjs": { "maxDuration": 60 } },
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
      { "key": "X-Frame-Options", "value": "DENY" },
      { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
    ] },
    { "source": "/", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/downloads/(.*)", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
  ]
}
