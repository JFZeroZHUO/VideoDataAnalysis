    "test": "node --test",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@vitejs/plugin-react": "4.3.4",
    "concurrently": "9.1.2",
    "express": "5.1.0",
    "lucide-react": "0.468.0",
    "playwright": "1.54.2",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "vite": "6.1.0"
  },
  "devDependencies": {
    "esbuild": "0.24.2",
    "fake-indexeddb": "6.2.5",
    "fflate": "0.8.3",
    "react-test-renderer": "19.0.0"
  }
}
