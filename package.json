{
  "name": "maternal-ai-video-radar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": "24.x" },
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"node --watch server/index.mjs\"",
    "dev:server": "node --watch server/index.mjs",
    "build": "vite build",
    "build:web": "node scripts/build-web.mjs",
    "build:extension": "node scripts/build-extension.mjs",
